rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Primitive Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 2. Entity Validations
    function isValidProject(data) {
      return data.id is string &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() <= 255 &&
             data.status in ["draft", "uploading", "ready", "processing", "completed", "error"] &&
             data.createdAt is string &&
             data.updatedAt is string;
    }

    function isValidWorkflow(data) {
      return data.id is string &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() <= 255 &&
             data.nodesJson is string &&
             data.edgesJson is string &&
             data.createdAt is string &&
             data.updatedAt is string;
    }

    function isValidStylePreset(data) {
      return data.id is string &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() <= 255 &&
             data.configJson is string &&
             data.createdAt is string &&
             data.updatedAt is string;
    }

    // 3. Collection Rules
    match /profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /projects/{projectId} {
      allow read, delete: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid;
    }

    match /workflows/{workflowId} {
      allow read, delete: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid;
    }

    match /style_presets/{presetId} {
      allow read, delete: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid;
    }

    match /transcripts/{transcriptionId} {
      allow read, delete: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid;
    }

    match /analyses/{analysisId} {
      allow read, delete: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid;
    }

    match /usage_events/{eventId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /render_jobs/{jobId} {
      allow read, delete: if isSignedIn() && (existing().userId == request.auth.uid || !("userId" in existing()));
      allow create: if isSignedIn() && 
                      incoming().userId == request.auth.uid &&
                      incoming().status == 'queued' &&
                      incoming().progress == 0 &&
                      incoming().claimedBy == null;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && (
                      // Permite apenas solicitar cancelamento
                      (incoming().diff(existing()).affectedKeys().hasOnly(['cancelRequested', 'updatedAt'])) ||
                      // Ou se for o backend (não aplicável via client SDK puro sem custom claims, 
                      // mas aqui as regras protegem o acesso do usuário final)
                      false
                    );
    }
  }
}
